# ==============================================================================
# Database Configuration (TimescaleDB / PostgreSQL 15)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agri_price_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agri_price_db

# ==============================================================================
# Application Settings & Timezone (Unified UTC+7 per Section 4.2)
# ==============================================================================
TIMEZONE=Asia/Ho_Chi_Minh
APP_ENV=development
LOG_LEVEL=INFO

# ==============================================================================
# External APIs
# ==============================================================================
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# ==============================================================================
# Notification & SMTP Configuration (Section 5.3, FR-26)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=agri_alert@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=agri_alert@example.com
ALERT_RECIPIENTS_DEFAULT=farmer_alert@example.com

